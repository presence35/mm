# Copy to .env and fill in. Never commit a real .env.

# --- required in production -------------------------------------------------
# Signs session tokens. If this is unset the server falls back to a literal
# dev secret, which means anyone can mint a valid token. Set it.
APP_SECRET=

# --- database ---------------------------------------------------------------
# NOTE: nothing reads this file. Set the variables in the shell or the host's
# environment. GoDaddy injects them into the Node process on deploy.
#
# Set DB_HOST to use MySQL. Leave unset for local SQLite in ./data/marina.db.
# DB_HOST=
# DB_USER=
# DB_PASSWORD=
# DB_NAME=
# DB_PORT=3306

# Physical table prefix. Defaults to mm_.
#
# This app shares one MySQL schema with the legacy app during cutover. The
# legacy tables are `service_cards`, `customers`, `photos`; ours have a
# different shape. Without a prefix, CREATE TABLE IF NOT EXISTS would adopt the
# legacy shape instead of creating ours, and reads would quietly return legacy
# columns. With it, the legacy tables are never written to, so rolling back is
# "redeploy the old repo".
#
# Letters, digits and underscores only — no dot-qualification.
# DB_PREFIX=mm_

# --- server -----------------------------------------------------------------
PORT=3000